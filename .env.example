# Required: public API origin used by browser requests
# Production MUST be the Cloudflare-fronted domain (https://api.lilienstore.com).
# Hitting *.onrender.com directly bypasses Cloudflare, so the backend can never see
# the visitor's country and every price falls back to GEL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional but recommended: server-side API origin for Next.js route handlers
API_BASE_URL=http://localhost:8000

# Required in production: shared secret that lets the backend trust the
# X-Visitor-Country / X-Visitor-IP headers we forward from SSR and /api/proxy.
# SERVER-ONLY — never rename this to NEXT_PUBLIC_*, that would ship it to the browser
# and let anyone pick their own currency.
INTERNAL_PROXY_TOKEN=

# Optional: canonical public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console site verification token
GOOGLE_SITE_VERIFICATION=
